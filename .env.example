# Host paths. INPUT_DIR must point to the already mounted network share.
INPUT_DIR=/mnt/network/scans
OUTPUT_DIR=/mnt/documents/sorted
DATA_DIR=./data
LOG_DIR=./logs

# Scanner
SCAN_INTERVAL=10
FILE_STABILITY_CHECKS=3
FILE_STABILITY_INTERVAL=5
MAX_FILE_WORKERS=2
MAX_ATTEMPTS=5
RETRY_BASE_SECONDS=60
RETRY_MAX_SECONDS=3600
STALE_PROCESSING_SECONDS=900
SCANNER_ENABLED=true
# Process only files modified within this many hours. 0 disables the filter
# (for a one-off import of an entire archive).
PROCESS_FILES_NEWER_THAN_HOURS=24

# Document processing
PDF_DPI=200
MAX_PDF_PAGES=100
MAX_DOCUMENT_SECONDS=90
MAX_IMAGE_PIXELS=80000000
BARCODE_FORMATS=Code128,Code39,EAN13,EAN8,QRCode,DataMatrix,PDF417,ITF

# Web interface
# WEB_HOST must stay 0.0.0.0 inside the container (the publish rule is WEB_BIND).
WEB_HOST=0.0.0.0
WEB_PORT=8000
# Host interface to publish on. Use 127.0.0.1 behind a reverse proxy.
WEB_BIND=0.0.0.0
WEB_USERNAME=admin
WEB_PASSWORD=change_me
# Optional password hash instead of WEB_PASSWORD (see README):
# WEB_PASSWORD_HASH=pbkdf2_sha256$600000$...
# Optional fixed session secret; otherwise generated in DATA_DIR:
# SESSION_SECRET=
SESSION_HTTPS_ONLY=false
# AUTH_ENABLED=false is only for isolated local debugging — never in production.
# AUTH_ENABLED=true
MAX_CSV_ROWS=100000
MAX_UPLOAD_BYTES=10485760
# Restrict accepted Host headers in production, comma-separated:
# ALLOWED_HOSTS=scans.example.local,localhost

# Misc
TZ=Europe/Moscow
LOG_LEVEL=INFO
